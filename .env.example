# Copy to .env (gitignored) and fill in.

# Cloudflare Tunnel connector token (long JWT-like string).
# Get from: Cloudflare dashboard → Zero Trust → Networks → Tunnels →
# (your tunnel) → Connector → "Copy Token"; OR via the API helper in
# infra/cloudflare/setup.sh.
CLOUDFLARED_TOKEN=

# Admin bearer token. Required to control the simulator from the dashboard
# (start/stop/rate). Also accepted on /api/produce (alongside PUBLIC_TOKEN).
BRIDGE_WRITE_TOKEN=

# Public lab token. Exposed via GET /api/config so the live-event page
# fetches it automatically and audience members don't have to paste any
# token to react/vote/ask. Accepted on /api/produce (NOT on /api/sim/*).
# Leave unset to disable zero-friction mode (admin-paste only).
BRIDGE_PUBLIC_TOKEN=

# Origin the bridge will accept CORS requests from. The default "*" is
# fine for a public dashboard; tighten to your Pages URL for safety.
BRIDGE_ALLOW_ORIGIN=*
